**Input Handling (Lines 635-647):**
```gdscript
func _input(event):
	"""Handle UI input"""
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_1, KEY_2, KEY_3, KEY_4, KEY_5:
				var slot_index = event.keycode - KEY_1
				cast_spell_from_slot(slot_index)
			KEY_6, KEY_7, KEY_8, KEY_9:
				var slot_index = event.keycode - KEY_6 + 5
				cast_spell_from_slot(slot_index)
			KEY_0:
				cast_spell_from_slot(9)
```

