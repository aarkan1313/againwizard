```gdscript
extends Node

var config = ConfigFile.new()
var settings_path = "user://settings.cfg"

var default_settings = {
    "graphics": {
        "fullscreen": false,
        "vsync": true
    },
    "audio": {
        "master_volume": 0.8,
        "sfx_volume": 0.8,
        "music_volume": 0.6
    },
    "gameplay": {
        "show_damage_numbers": true,
        "auto_save_interval": 60.0  # seconds
    }
}

var current_settings = {}

func _ready():
    load_settings()
    apply_all_settings()

func load_settings():
    if config.load(settings_path) != OK:
        # First time, use defaults
        current_settings = default_settings.duplicate(true)
        save_settings()
    else:
        # Load each category with validation
        for category in default_settings:
            current_settings[category] = {}
            for key in default_settings[category]:
                var default_value = default_settings[category][key]
                var loaded_value = config.get_value(category, key, default_value)
                current_settings[category][key] = _validate_setting(category, key, loaded_value)

func _validate_setting(category: String, key: String, value):
    match category:
        "audio":
            if key.ends_with("_volume"):
                return clamp(value, 0.0, 1.0)
        "gameplay":
            if key == "auto_save_interval":
                return max(30.0, value)  # Minimum 30 seconds
    return value

func save_settings() -> bool:
    for category in current_settings:
        for key in current_settings[category]:
            config.set_value(category, key, current_settings[category][key])
    
    if config.save(settings_path) != OK:
        push_error("Failed to save settings")
        return false
    return true

func get_setting(category: String, key: String):
    if current_settings.has(category) and current_settings[category].has(key):
        return current_settings[category][key]
    else:
        push_error("Setting not found: %s.%s" % [category, key])
        return null

func set_setting(category: String, key: String, value):
    if not current_settings.has(category):
        push_error("Invalid category: " + category)
        return
        
    current_settings[category][key] = _validate_setting(category, key, value)
    save_settings()
    _apply_setting(category, key, current_settings[category][key])

func reset_to_defaults():
    current_settings = default_settings.duplicate(true)
    save_settings()
    apply_all_settings()

func apply_all_settings():
    # Graphics
    _apply_fullscreen(current_settings.graphics.fullscreen)
    _apply_vsync(current_settings.graphics.vsync)
    
    # Audio
    AudioServer.set_bus_volume_db(0, linear_to_db(current_settings.audio.master_volume))
    # SFX and Music buses will be set up in Phase 6
    
    # Gameplay
    _apply_damage_numbers(current_settings.gameplay.show_damage_numbers)

func _apply_setting(category: String, key: String, value):
    match category:
        "graphics":
            match key:
                "fullscreen":
                    _apply_fullscreen(value)
                "vsync":
                    _apply_vsync(value)
        "audio":
            match key:
                "master_volume":
                    AudioServer.set_bus_volume_db(0, linear_to_db(value))
        "gameplay":
            match key:
                "show_damage_numbers":
                    _apply_damage_numbers(value)

func _apply_fullscreen(enabled: bool):
    if enabled:
        DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
    else:
        DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)

func _apply_vsync(enabled: bool):
