**Update Main.gd to handle run loading**:
```gdscript
extends Node2D

@onready var player = $Player
@onready var ui = $UI

func _ready():
    # Ensure game state
    GameStateManager.change_state(GameStateManager.GameState.PLAYING)
    
    # Check if we're continuing a run
    var run_data = RunSaveManager.load_run()
    if run_data.size() > 0:
        if _load_run_state(run_data):
            # Successfully loaded - now safe to delete
            RunSaveManager.delete_run()
        else:
            # Load failed - try backup
            push_error("Failed to load run, trying backup...")
            if RunSaveManager.restore_from_backup():
                run_data = RunSaveManager.load_run()
                if _load_run_state(run_data):
                    RunSaveManager.delete_run()
                else:
                    _start_fresh_run()
            else:
                _start_fresh_run()
    else:
        # New run
        RunSaveManager.start_new_run()
        _start_fresh_run()
    
    # Fade in
    SceneTransition.fade_in()

func _load_run_state(data: Dictionary) -> bool:
    if not data.has("player") or not data.has("wave"):
        push_error("Invalid save data")
        return false
    
    try:
        # Restore wave state
        WaveManager.current_wave = data.wave
        WaveManager.total_enemies_killed = data.kills
        
        # Note: xp_earned is tracked but player always starts at current XP
        # from save (no additional XP added when loading)
        
        # Restore player state
        var p = data.player
        player.global_position = Vector2(p.position[0], p.position[1])
        player.level = p.level
        player.xp = p.xp
        player.xp_to_next_level = p.xp_to_next_level
        player.stat_points = p.stat_points
        player.stats = p.stats
        
        # Restore HP/Mana (max values calculated from level)
        player.max_hp = 100 + (p.level - 1) * 10
        player.max_mana = 50 + (p.level - 1) * 5
        player.hp = min(p.hp, player.max_hp)  # Clamp to current max
        player.mana = min(p.mana, player.max_mana)
        
        # Update UI
        player.update_ui()
        
        # Start appropriate wave
        WaveManager.start_wave()
        
        return true
    except:
        push_error("Exception while loading save")
        return false

func _start_fresh_run():
    # Initialize fresh game state
    WaveManager.reset()
    player.reset_to_defaults()
    WaveManager.start_wave()

func _input(event):
    if event.is_action_pressed("escape"):
        match GameStateManager.current_state:
            GameStateManager.GameState.PLAYING:
                if not player.is_dead:
                    GameStateManager.change_state(GameStateManager.GameState.PAUSED)
            GameStateManager.GameState.PAUSED:
                GameStateManager.change_state(GameStateManager.GameState.PLAYING)
