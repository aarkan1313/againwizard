@onready var music_slider = $Panel/TabContainer/Audio/MusicVolume/Slider
@onready var music_value = $Panel/TabContainer/Audio/MusicVolume/Value
@onready var damage_check = $Panel/TabContainer/Gameplay/DamageCheck
@onready var apply_button = $Panel/Buttons/ApplyButton

var is_loading = false
var has_changes = false
var initial_settings = {}

func _ready():
    process_mode = Node.PROCESS_MODE_WHEN_PAUSED
    
    # Connect signals
    fullscreen_check.toggled.connect(_on_setting_changed)
    vsync_check.toggled.connect(_on_setting_changed)
    master_slider.value_changed.connect(_on_master_changed)
    sfx_slider.value_changed.connect(_on_sfx_changed)
    music_slider.value_changed.connect(_on_music_changed)
    damage_check.toggled.connect(_on_setting_changed)
    
    $Panel/Header/CloseButton.pressed.connect(_on_back)
    $Panel/Buttons/ResetButton.pressed.connect(_on_reset)
    $Panel/Buttons/ApplyButton.pressed.connect(_on_apply)
    $Panel/Buttons/BackButton.pressed.connect(_on_back)
    
    # Configure sliders
    for slider in [master_slider, sfx_slider, music_slider]:
        slider.min_value = 0.0
        slider.max_value = 1.0
        slider.step = 0.05
    
    # Load current settings
    _load_current_settings()

func _load_current_settings():
    is_loading = true
    
    # Store initial values
    initial_settings = {
        "fullscreen": SettingsManager.get_setting("graphics", "fullscreen"),
        "vsync": SettingsManager.get_setting("graphics", "vsync"),
        "master_volume": SettingsManager.get_setting("audio", "master_volume"),
        "sfx_volume": SettingsManager.get_setting("audio", "sfx_volume"),
        "music_volume": SettingsManager.get_setting("audio", "music_volume"),
        "show_damage_numbers": SettingsManager.get_setting("gameplay", "show_damage_numbers")
    }
    
    # Apply to UI
    fullscreen_check.button_pressed = initial_settings.fullscreen
    vsync_check.button_pressed = initial_settings.vsync
    master_slider.value = initial_settings.master_volume
    sfx_slider.value = initial_settings.sfx_volume
    music_slider.value = initial_settings.music_volume
    damage_check.button_pressed = initial_settings.show_damage_numbers
    
    _update_volume_labels()
    is_loading = false
    has_changes = false
    apply_button.disabled = true

func _on_setting_changed(value):
    if not is_loading:
        _check_for_changes()

func _on_master_changed(value: float):
    master_value.text = str(int(value * 100)) + "%"
    if not is_loading:
        SettingsManager.set_setting("audio", "master_volume", value)
        _check_for_changes()

func _on_sfx_changed(value: float):
    sfx_value.text = str(int(value * 100)) + "%"
    if not is_loading:
        _check_for_changes()

func _on_music_changed(value: float):
    music_value.text = str(int(value * 100)) + "%"
    if not is_loading:
        _check_for_changes()

func _check_for_changes():
    has_changes = (
        fullscreen_check.button_pressed != initial_settings.fullscreen or
        vsync_check.button_pressed != initial_settings.vsync or
        abs(master_slider.value - initial_settings.master_volume) > 0.01 or
        abs(sfx_slider.value - initial_settings.sfx_volume) > 0.01 or
        abs(music_slider.value - initial_settings.music_volume) > 0.01 or
        damage_check.button_pressed != initial_settings.show_damage_numbers
    )
    apply_button.disabled = not has_changes

func _update_volume_labels():
    master_value.text = str(int(master_slider.value * 100)) + "%"
    sfx_value.text = str(int(sfx_slider.value * 100)) + "%"
    music_value.text = str(int(music_slider.value * 100)) + "%"

func _on_apply():
    # Apply all settings
    SettingsManager.set_setting("graphics", "fullscreen", fullscreen_check.button_pressed)
    SettingsManager.set_setting("graphics", "vsync", vsync_check.button_pressed)
    SettingsManager.set_setting("audio", "master_volume", master_slider.value)
    SettingsManager.set_setting("audio", "sfx_volume", sfx_slider.value)
    SettingsManager.set_setting("audio", "music_volume", music_slider.value)
    SettingsManager.set_setting("gameplay", "show_damage_numbers", damage_check.button_pressed)
    
    # Update initial settings
    _load_current_settings()

func _on_reset():
    var confirm = ConfirmationDialog.new()
    confirm.dialog_text = "Reset all settings to defaults?"
    confirm.confirmed.connect(_confirm_reset)
    add_child(confirm)
    confirm.popup_centered()

func _confirm_reset():
    SettingsManager.reset_to_defaults()
    _load_current_settings()

func _on_back():
    if has_changes:
        var confirm = ConfirmationDialog.new()
        confirm.dialog_text = "Discard unsaved changes?"
        confirm.confirmed.connect(queue_free)
        add_child(confirm)
        confirm.popup_centered()
    else:
        queue_free()
