### Morning (2 hours): Save System Architecture

**Create `scripts/core/MetaSaveManager.gd`** (Autoload) - Handles persistent character data:
```gdscript
extends Node

const SAVE_VERSION = 1
const MAX_SLOTS = 3
var current_slot: int = 1
var meta_data = {
    "version": SAVE_VERSION,
    "total_xp": 0,
    "lifetime_kills": 0,
    "highest_wave": 0,
    "unlocked_spells": ["fireball"],
    "currency": 0,
    "total_playtime": 0.0,
    "first_played": 0,
    "last_played": 0
}

func get_save_path(slot: int) -> String:
    return "user://meta_save_slot%d.dat" % slot

func get_all_slots_info() -> Array:
    var slots = []
    for i in range(1, MAX_SLOTS + 1):
        var path = get_save_path(i)
        if FileAccess.file_exists(path):
            var file = FileAccess.open(path, FileAccess.READ)
            if file:
                # Load with decompression
                var original_size = file.get_32()
                var compressed_buffer = file.get_buffer(file.get_length() - file.get_position())
                file.close()
                
                var decompressed = compressed_buffer.decompress(original_size, FileAccess.COMPRESSION_GZIP)
                var data_string = decompressed.get_string_from_utf8()
                var data = str_to_var(data_string)
                
                slots.append({
                    "slot": i,
                    "exists": true,
                    "character_level": data.get("character_level", 1),
                    "total_xp": data.get("total_xp", 0),
                    "highest_wave": data.get("highest_wave", 0),
                    "last_played": data.get("last_played", 0)
                })
            else:
                slots.append({"slot": i, "exists": false})
        else:
            slots.append({"slot": i, "exists": false})
    return slots

func set_current_slot(slot: int):
    if slot < 1 or slot > MAX_SLOTS:
        push_error("Invalid slot number: " + str(slot))
        return
    current_slot = slot
    load_meta()

func _ready():
    # Don't auto-load - wait for slot selection
    pass

func save_meta():
    var path = get_save_path(current_slot)
    var file = FileAccess.open(path, FileAccess.WRITE)
    if file == null:
        push_error("Failed to save meta data")
        return false
    
    # Update timestamps
    if meta_data.first_played == 0:
        meta_data.first_played = Time.get_unix_time_from_system()
    meta_data.last_played = Time.get_unix_time_from_system()
    
    # Save with compression
    var data_string = var_to_str(meta_data)
    file.store_32(data_string.length())  # Store original size
    file.store_buffer(data_string.to_utf8_buffer().compress(FileAccess.COMPRESSION_GZIP))
    file.close()
    return true

func load_meta(slot: int = -1):
    if slot == -1:
        slot = current_slot
        
    var path = get_save_path(slot)
    if not FileAccess.file_exists(path):
        # Create default for new slot
        meta_data = {
            "version": SAVE_VERSION,
            "total_xp": 0,
            "character_level": 1,
            "unspent_stat_points": 0,
            "character_stats": {
                "strength": 10,
                "intelligence": 10,
                "agility": 10
            },
            "lifetime_kills": 0,
            "highest_wave": 0,
            "unlocked_spells": ["fireball"],
            "currency": 0,
            "total_playtime": 0.0,
            "first_played": 0,
            "last_played": 0,
            "steam_cloud_enabled": true
        }
        save_meta()
        return
        
    var file = FileAccess.open(path, FileAccess.READ)
    if file == null:
        push_error("Failed to load meta data")
        return
    
    # Load with decompression
    var original_size = file.get_32()
    var compressed_buffer = file.get_buffer(file.get_length() - file.get_position())
    file.close()
    
    var decompressed = compressed_buffer.decompress(original_size, FileAccess.COMPRESSION_GZIP)
    var data_string = decompressed.get_string_from_utf8()
    var loaded_data = str_to_var(data_string)
    
    # Version migration if needed
    if not loaded_data.has("version") or loaded_data.version < SAVE_VERSION:
        _migrate_meta_save(loaded_data)
    else:
        meta_data = loaded_data

func delete_slot(slot: int):
    if slot == current_slot:
        push_error("Cannot delete current slot")
        return false
        
    var path = get_save_path(slot)
    if FileAccess.file_exists(path):
        DirAccess.remove_absolute(path)
        return true
    return false

func _migrate_meta_save(old_data: Dictionary):
    # Preserve existing data while adding new fields
    for key in old_data:
        if meta_data.has(key):
            meta_data[key] = old_data[key]
    
    # Ensure new fields exist with defaults
    if not meta_data.has("character_level"):
        meta_data.character_level = 1
    if not meta_data.has("unspent_stat_points"):
        meta_data.unspent_stat_points = 0
    if not meta_data.has("character_stats"):
        meta_data.character_stats = {
            "strength": 10,
            "intelligence": 10,
            "agility": 10
        }
    if not meta_data.has("steam_cloud_enabled"):
        meta_data.steam_cloud_enabled = true
    
    meta_data.version = SAVE_VERSION
    save_meta()

func add_run_rewards(wave: int, kills: int, time: float, player_data: Dictionary):
    meta_data.lifetime_kills += kills
    meta_data.total_playtime += time
    
    # Update persistent character progress
    meta_data.total_xp = player_data.xp
    meta_data.character_level = player_data.level
    meta_data.unspent_stat_points = player_data.stat_points
    meta_data.character_stats = player_data.stats
    
    if wave > meta_data.highest_wave:
        meta_data.highest_wave = wave
    
    if save_meta():
        return true
    else:
        push_error("Failed to save meta progress!")
        return false

func update_character_progress(level: int, xp: int, stat_points: int, stats: Dictionary):
    # Called when player levels up during gameplay
    meta_data.character_level = level
    meta_data.total_xp = xp
    meta_data.unspent_stat_points = stat_points
    meta_data.character_stats = stats
    save_meta()
```

**Create `scripts/core/RunSaveManager.gd`** (Autoload) - Handles suspend/resume for current run:
```gdscript
extends Node

const SAVE_VERSION = 1
var run_path = "user://run_save.dat"
var run_backup_path = "user://run_save.dat.bak"
var current_run_start_time: float = 0.0
var pending_delete: bool = false

func get_run_save_path() -> String:
    return "user://run_save_slot%d.dat" % MetaSaveManager.current_slot

func get_run_backup_path() -> String:
    return "user://run_save_slot%d.dat.bak" % MetaSaveManager.current_slot

func has_active_run() -> bool:
    return FileAccess.file_exists(get_run_save_path()) and not pending_delete

func save_run():
    if not is_instance_valid(GameManager.player):
        push_error("Cannot save run - player not valid")
        return false
    
    var save_path = get_run_save_path()
    var backup_path = get_run_backup_path()
    
    # Backup existing save first
    if FileAccess.file_exists(save_path):
        DirAccess.copy_absolute(save_path, backup_path)
    
    var data = {
        "version": SAVE_VERSION,
        "slot": MetaSaveManager.current_slot,
        "wave": WaveManager.current_wave,
        "kills": WaveManager.total_enemies_killed,
        "run_time": Time.get_ticks_msec() / 1000.0 - current_run_start_time,
        "xp_earned": GameManager.player.xp,  # Track XP earned this run
        "location": "combat",  # Future: "hub" or "combat"
        "player": {
            "position": [GameManager.player.global_position.x, GameManager.player.global_position.y],
            "hp": GameManager.player.hp,
            "max_hp": GameManager.player.max_hp,
            "mana": GameManager.player.mana,
            "max_mana": GameManager.player.max_mana,
            "level": GameManager.player.level,
            "xp": GameManager.player.xp,
            "xp_to_next_level": GameManager.player.xp_to_next_level,
            "stat_points": GameManager.player.stat_points,
            "stats": GameManager.player.stats
        },
        "timestamp": Time.get_unix_time_from_system()
    }
    
    var file = FileAccess.open(save_path, FileAccess.WRITE)
    if file == null:
        push_error("Failed to save run data")
        return false
    
    # Save with compression
    var data_string = var_to_str(data)
    file.store_32(data_string.length())
    file.store_buffer(data_string.to_utf8_buffer().compress(FileAccess.COMPRESSION_GZIP))
    file.close()
    return true

func load_run() -> Dictionary:
    if not has_active_run():
        return {}
    
    var save_path = get_run_save_path()
    var file = FileAccess.open(save_path, FileAccess.READ)
    if file == null:
        push_error("Failed to load run data")
        return {}
    
    # Load with decompression
    var original_size = file.get_32()
    var compressed_buffer = file.get_buffer(file.get_length() - file.get_position())
    file.close()
    
    var decompressed = compressed_buffer.decompress(original_size, FileAccess.COMPRESSION_GZIP)
    var data_string = decompressed.get_string_from_utf8()
    var data = str_to_var(data_string)
    
    # Verify this save belongs to current slot
    if data.has("slot") and data.slot != MetaSaveManager.current_slot:
        push_error("Run save is for different slot!")
        return {}
    
    # Restore run timer
    if data.has("run_time"):
        current_run_start_time = Time.get_ticks_msec() / 1000.0 - data.run_time
    
    return data

func delete_run():
    var save_path = get_run_save_path()
    var backup_path = get_run_backup_path()
    
    if FileAccess.file_exists(save_path):
        DirAccess.remove_absolute(save_path)
    if FileAccess.file_exists(backup_path):
        DirAccess.remove_absolute(backup_path)
    pending_delete = false

func mark_for_deletion():
    pending_delete = true

func start_new_run():
    current_run_start_time = Time.get_ticks_msec() / 1000.0
    delete_run()  # Clear any existing

func restore_from_backup() -> bool:
    var save_path = get_run_save_path()
    var backup_path = get_run_backup_path()
    
    if FileAccess.file_exists(backup_path):
        DirAccess.copy_absolute(backup_path, save_path)
        return true
    return false
```

