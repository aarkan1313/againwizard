func _show_slot_selection():
    main_panel.hide()
    slot_panel.show()
    
    # Update slot info
    var slots = MetaSaveManager.get_all_slots_info()
    for i in range(3):
        var slot_data = slots[i]
        var btn = slot_buttons[i]
        
        if slot_data.exists:
            var time_str = _format_last_played(slot_data.last_played)
            btn.text = "Slot %d\nLevel %d | Wave %d\n%s" % [
                i + 1,
                slot_data.character_level,
                slot_data.highest_wave,
                time_str
            ]
        else:
            btn.text = "Slot %d\n[Empty]" % [i + 1]

func _format_last_played(timestamp: float) -> String:
    if timestamp == 0:
        return "Never"
    
    var current = Time.get_unix_time_from_system()
    var diff = current - timestamp
    
    if diff < 3600:  # Less than 1 hour
        return "%d min ago" % [diff / 60]
    elif diff < 86400:  # Less than 1 day
        return "%d hours ago" % [diff / 3600]
    else:
        return "%d days ago" % [diff / 86400]

func _on_slot_selected(slot: int):
    MetaSaveManager.set_current_slot(slot)
    _show_main_menu()

