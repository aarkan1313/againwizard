**Create `scripts/core/GameStateManager.gd`** (Autoload):
```gdscript
extends Node

enum GameState { MAIN_MENU, HUB, PLAYING, PAUSED, GAME_OVER }

var current_state: GameState = GameState.MAIN_MENU
var previous_state: GameState = GameState.MAIN_MENU
signal state_changed(new_state, old_state)

func _ready():
    process_mode = Node.PROCESS_MODE_ALWAYS

func change_state(new_state: GameState):
    if current_state == new_state:
        return
        
    previous_state = current_state
    current_state = new_state
    
    match current_state:
        GameState.MAIN_MENU:
            get_tree().paused = false
            Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
        GameState.HUB:
            get_tree().paused = false
            Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
        GameState.PLAYING:
            get_tree().paused = false
            Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
        GameState.PAUSED:
            get_tree().paused = true
            Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
            # Auto-save when pausing
            if is_instance_valid(GameManager.player) and not GameManager.player.is_dead:
                RunSaveManager.save_run()
        GameState.GAME_OVER:
            get_tree().paused = true
            Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
    
    state_changed.emit(current_state, previous_state)

func get_previous_state() -> GameState:
    return previous_state
```

