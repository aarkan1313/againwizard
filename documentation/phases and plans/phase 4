extends Control

@onready var fullscreen_check = $Panel/TabContainer/Graphics/FullscreenCheck
@onready var vsync_check = $Panel/TabContainer/Graphics/VSyncCheck
@onready var master_slider = $Panel/TabContainer/Audio/MasterVolume/Slider
